# Same Supabase project as the main MoDA app — the admin area reads the
# same database through the same RLS, with a superadmin role on top.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# There is deliberately NO service-role key here. The admin app signs in
# as a normal user and the database decides what it may see.
